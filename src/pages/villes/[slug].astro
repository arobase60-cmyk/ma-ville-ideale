---
import cities from "../../data/cities.json";

export function getStaticPaths() {
  return cities.map((city) => ({
    params: { slug: city.slug },
    props: { city }
  }));
}

const { city } = Astro.props;
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{city.name} — Ma Ville Idéale</title>

  <style>
    :global(*) {
      box-sizing: border-box;
    }

    :global(body) {
      margin: 0;
      font-family: system-ui, sans-serif;
      background: #f5f7fa;
      color: #172033;
    }

    .hero {
      background: linear-gradient(135deg, #2563eb, #0f766e);
      color: white;
      padding: 3rem 1.5rem;
    }

    .container {
      max-width: 1000px;
      margin: 0 auto;
      padding: 0 1rem;
    }

    .hero h1 {
      margin: 0 0 0.5rem;
      font-size: 2.5rem;
    }

    .hero p {
      margin: 0;
      opacity: 0.9;
    }

    .back {
      display: inline-block;
      margin-bottom: 1.5rem;
      color: white;
      text-decoration: none;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
      margin-top: 2rem;
    }

    .card {
      background: white;
      border-radius: 12px;
      padding: 1.3rem;
      box-shadow: 0 3px 12px rgba(0, 0, 0, 0.06);
    }

    .card h2 {
      margin-top: 0;
      font-size: 1.1rem;
    }

    .big-value {
      font-size: 1.8rem;
      font-weight: 800;
      color: #2563eb;
    }

    .score {
      margin-top: 2rem;
      background: #dbeafe;
      border-radius: 14px;
      padding: 1.5rem;
      text-align: center;
    }

    .score-number {
      font-size: 3rem;
      font-weight: 900;
      color: #1d4ed8;
    }

    .scores {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
      margin-top: 1rem;
    }

    .score-item {
      background: white;
      padding: 1rem;
      border-radius: 10px;
      text-align: center;
    }

    .score-item strong {
      display: block;
      font-size: 1.4rem;
      color: #2563eb;
    }

    @media (max-width: 700px) {
      .grid,
      .scores {
        grid-template-columns: 1fr;
      }

      .hero h1 {
        font-size: 2rem;
      }
    }
  </style>
</head>

<body>

  <header class="hero">
    <div class="container">

      <a class="back" href="/">
        ← Retour au comparateur
      </a>

      <h1>{city.name}</h1>
      <p>{city.region}</p>

    </div>
  </header>

  <main class="container">

    <div class="score">
      <div>Profil global de la commune</div>
      <div class="score-number">—</div>
      <div>Score personnalisé selon vos critères</div>
    </div>

    <div class="grid">

      <div class="card">
        <h2>🏠 Immobilier</h2>
        <div class="big-value">
          {city.priceSqm.toLocaleString("fr-FR")} €/m²
        </div>
        <p>Prix indicatif des maisons</p>
      </div>

      <div class="card">
        <h2>👥 Population</h2>
        <div class="big-value">
          {city.population.toLocaleString("fr-FR")}
        </div>
        <p>Habitants</p>
      </div>

      <div class="card">
        <h2>☀️ Ensoleillement</h2>
        <div class="big-value">
          {city.sunHours.toLocaleString("fr-FR")} h/an
        </div>
      </div>

      <div class="card">
        <h2>🌊 Mer</h2>
        <div class="big-value">
          {city.distanceSeaKm} km
        </div>
        <p>Distance indicative</p>
      </div>

    </div>

    <h2>Les critères</h2>

    <div class="scores">

      <div class="score-item">
        🛒 Commerces
        <strong>{city.scores.commerce}/10</strong>
      </div>

      <div class="score-item">
        🏥 Santé
        <strong>{city.scores.health}/10</strong>
      </div>

      <div class="score-item">
        🛡️ Sécurité
        <strong>{city.scores.safety}/10</strong>
      </div>

      <div class="score-item">
        🌳 Tranquillité
        <strong>{city.scores.tranquility}/10</strong>
      </div>

      <div class="score-item">
        ☀️ Soleil
        <strong>{city.scores.sun}/10</strong>
      </div>

      <div class="score-item">
        🚗 Accessibilité
        <strong>{city.scores.accessibility}/10</strong>
      </div>

      <div class="score-item">
        🌧️ Risques
        <strong>{city.scores.risk}/10</strong>
      </div>

      <div class="score-item">
        🏠 Prix
        <strong>{city.scores.price}/10</strong>
      </div>

    </div>

  </main>

</body>
</html>