---
import fs from "node:fs";
import path from "node:path";

export function getStaticPaths() {
  const directory = path.join(process.cwd(), "public/data/departements");

  const files = fs.readdirSync(directory)
    .filter((file) => /^\d{2,3}\.json$/.test(file));

  return files.flatMap((file) => {
    const communes = JSON.parse(
      fs.readFileSync(path.join(directory, file), "utf-8")
    );

    return communes.map((city: { code: string }) => ({
      params: { slug: city.code },
      props: { city }
    }));
  });
}

const { city } = Astro.props;
---



<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{city.name} — Ma Ville Idéale</title>

  <style>
    :global(*) {
      box-sizing: border-box;
    }

    :global(body) {
      margin: 0;
      font-family: system-ui, sans-serif;
      background: #f5f7fa;
      color: #172033;
    }

    .hero {
      background: linear-gradient(135deg, #2563eb, #0f766e);
      color: white;
      padding: 3rem 1.5rem;
    }

    .container {
      max-width: 1000px;
      margin: 0 auto;
      padding: 0 1rem;
    }

    .hero h1 {
      margin: 0 0 0.5rem;
      font-size: 2.5rem;
    }

    .hero p {
      margin: 0;
      opacity: 0.9;
    }

    .back {
      display: inline-block;
      margin-bottom: 1.5rem;
      color: white;
      text-decoration: none;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
      margin-top: 2rem;
    }

    .card {
      background: white;
      border-radius: 12px;
      padding: 1.3rem;
      box-shadow: 0 3px 12px rgba(0, 0, 0, 0.06);
    }

    .card h2 {
      margin-top: 0;
      font-size: 1.1rem;
    }

    .big-value {
      font-size: 1.8rem;
      font-weight: 800;
      color: #2563eb;
    }

    .score {
      margin-top: 2rem;
      background: #dbeafe;
      border-radius: 14px;
      padding: 1.5rem;
      text-align: center;
    }

    .score-number {
      font-size: 3rem;
      font-weight: 900;
      color: #1d4ed8;
    }

    .scores {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
      margin-top: 1rem;
    }

    .score-item {
      background: white;
      padding: 1rem;
      border-radius: 10px;
      text-align: center;
    }

    .score-item strong {
      display: block;
      font-size: 1.4rem;
      color: #2563eb;
    }

    @media (max-width: 700px) {
      .grid,
      .scores {
        grid-template-columns: 1fr;
      }

      .hero h1 {
        font-size: 2rem;
      }
    }
  </style>
</head>

<body>

  <header class="hero">
    <div class="container">

      <a class="back" href="/">
        ← Retour au comparateur
      </a>

      <h1>{city.name}</h1>
      
<p>
  {city.postalCodes?.join(", ") || "Code postal non renseigné"}
</p>


    </div>
  </header>

  <main class="container">

    
<div class="score">
  <h2>Informations générales</h2>
  <div class="score-number">{city.name}</div>
  <p>
    Code INSEE : {city.code}
    —
    Code postal : {city.postalCodes?.join(", ") || "Non renseigné"}
  </p>
  <p>
    Population :
    {city.population != null
      ? city.population.toLocaleString("fr-FR")
      : "Non renseignée"}
    habitants
  </p>
</div>


    <div class="grid">

      <div class="card">
        <h2>🏠 Immobilier</h2>
        <div class="big-value">
          
{city.immobilier?.housePriceM2 != null
  ? `${city.immobilier.housePriceM2.toLocaleString("fr-FR")} €/m²`
  : "Donnée indisponible"}

        </div>
        <p>Prix indicatif des maisons</p>
      </div>

      <div class="card">
        <h2>👥 Population</h2>
        <div class="big-value">
          {city.population.toLocaleString("fr-FR")}
        </div>
        <p>Habitants</p>
      </div>

      <div class="card">
        <h2>☀️ Ensoleillement</h2>
        <div class="big-value">
          {city.sunHours.toLocaleString("fr-FR")} h/an
        </div>
      </div>

      <div class="card">
        <h2>🌊 Mer</h2>
        <div class="big-value">
          {city.distanceSeaKm} km
        </div>
        <p>Distance indicative</p>
      </div>

    </div>

<h2>🏥 Santé et services médicaux</h2>

<div class="grid">
  <div class="card">
    <h2>👨‍⚕️ Médecins</h2>
    <div class="big-value">
      {city.services?.doctors ?? "Non renseigné"}
    </div>
  </div>

  <div class="card">
    <h2>💊 Pharmacies</h2>
    <div class="big-value">
      {city.services?.pharmacies ?? "Non renseigné"}
    </div>
  </div>

  <div class="card">
    <h2>🦷 Dentistes</h2>
    <div class="big-value">
      {city.services?.dentists ?? "Non renseigné"}
    </div>
  </div>

  <div class="card">
    <h2>🏥 Hôpitaux</h2>
    <div class="big-value">
      {city.services?.hospitals ?? "Non renseigné"}
    </div>
  </div>
</div>


<h2>🛒 Commerces de proximité</h2>

<div class="grid">
  <div class="card">
    <h2>🛒 Supermarchés</h2>
    <div class="big-value">
      {city.services?.supermarkets ?? "Non renseigné"}
    </div>
  </div>

  <div class="card">
    <h2>🥖 Boulangeries</h2>
    <div class="big-value">
      {city.services?.bakeries ?? "Non renseigné"}
    </div>
  </div>

  <div class="card">
    <h2>🏪 Épiceries</h2>
    <div class="big-value">
      {city.services?.grocery ?? "Non renseigné"}
    </div>
  </div>
</div>


    

    
<h2>🛡️ Sécurité de la commune</h2>

<div class="grid">
  <div class="card">
    <h2>Score de sécurité</h2>
    <div class="big-value">
      {city.security?.score != null
        ? `${city.security.score}/10`
        : "Non renseigné"}
    </div>
  </div>

  <div class="card">
    <h2>Nombre de cambriolages en 2025</h2>
    <div class="big-value">
      {city.security?.burglaryCount ?? "Non renseigné"}
    </div>
    <p>Nombre recensé dans les données disponibles</p>
  </div>

  <div class="card">
    <h2>Taux de cambriolages en 2025</h2>
    <div class="big-value">
      {city.security?.burglaryRate != null

       ? `${city.security.burglaryRate.toLocaleString("fr-FR", {
    maximumFractionDigits: 2
  })} ‰`


        : "Non renseigné"}
    </div>
    <p>Pour 1 000 logements — année 2025 (‰)</p>
  </div>
</div>

<h2>📊 Détail des faits de délinquance — 2025</h2>
<p>
  Données de délinquance enregistrée pour l'année 2025.
  Les nombres correspondent aux faits recensés durant cette année.
  Les taux sont exprimés pour 1 000 habitants lorsque cet indicateur
  utilise la population comme référence.
  Certaines données ne sont pas diffusées pour des raisons de confidentialité statistique.
</p>
<div class="grid">
  {Object.entries(city.security?.details ?? {}).map(([label, info]: [string, any]) => (
    <div class="card">
      <h2>{label}</h2>

<style>
  .unavailable-value {
    font-size: 1.1rem;
    font-weight: 500;
    color: #64748b;
    margin: 1rem 0;
  }
</style>


     <div class={info.published === true && info.count != null
  ? "big-value"
  : "unavailable-value"}>
  {info.published === true && info.count != null
    ? info.count.toLocaleString("fr-FR")
    : "Données non diffusées"}
</div>

      <p>
        {info.published === true && info.rate != null
          ? `Taux : ${info.rate.toLocaleString("fr-FR", { maximumFractionDigits: 2 })} ‰`
          : "Taux non disponible"}
      </p>
    </div>
  ))}
</div>

<h2>🌧️ Risques naturels — Inondations</h2>

<div class="grid">
  <div class="card">
    <h2>Arrêtés de catastrophe naturelle</h2>
    <div class="big-value">
      {city.risks?.floodCatNat ?? "Non renseigné"}
    </div>
    <p>Nombre d'arrêtés liés aux inondations dans les données disponibles</p>
  </div>

  <div class="card">
    <h2>Arrêtés d'inondation sur les 10 dernières années</h2>
    <div class="big-value">
      {city.risks?.floodCatNat10Years ?? "Non renseigné"}
    </div>
  </div>

  <div class="card">
    <h2>Dernier arrêté recensé</h2>
    <div class="big-value">
      {city.risks?.lastFloodCatNat
        ? new Date(city.risks.lastFloodCatNat).toLocaleDateString("fr-FR")
        : "Non renseigné"}
    </div>
  </div>
</div>

<p>
  ℹ️ Ces informations concernent les arrêtés de catastrophe
  naturelle. Elles ne permettent pas, à elles seules,
  de déterminer si une maison se trouve en zone inondable.
  Pour une adresse précise, consultez Géorisques.
</p>

<p>
  <a
    href="https://www.georisques.gouv.fr/"
