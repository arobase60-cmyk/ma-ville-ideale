	function calculateCommerceScore(city) {
  const services = city.services;

  if (!services) return null;

  const supermarkets = services.supermarkets;
const grocery = services.grocery;
const bakeries = services.bakeries;

if (
  supermarkets == null &&
  grocery == null &&
  bakeries == null
) {
  return null;
}

  let score = 0;

  // ==============================
  // COMMERCE DE BASE
  // ==============================

  if (supermarkets > 0) score += 3;
  if (grocery > 0) score += 2;
  if (bakeries > 0) score += 2;

  // ==============================
  // DIVERSITÉ / QUANTITÉ
  // ==============================

  if (supermarkets >= 2) score += 1.5;
  if (supermarkets >= 3) score += 1;

  if (grocery >= 2) score += 0.75;
  if (grocery >= 3) score += 0.75;

  if (bakeries >= 2) score += 0.75;
  if (bakeries >= 3) score += 0.75;

  return Math.min(10, score);
}

function calculateHealthScore(city) {
  const services = city.services;

  if (!services) return null;

  const doctors = services.doctors;
const dentists = services.dentists;
const pharmacies = services.pharmacies;
const hospitals = services.hospitals;

if (
  doctors == null &&
  dentists == null &&
  pharmacies == null
) {
  return null;
}

  // ==============================
  // HÔPITAL
  // ==============================

  if (hospitals > 0) {
    return 10;
  }

  // ==============================
  // MÉDECINS
  // ==============================

  let score = 0;

  if (doctors >= 10) {
    score = 7;
  } else if (doctors >= 7) {
    score = 6;
  } else if (doctors >= 5) {
    score = 5;
  } else if (doctors >= 3) {
    score = 4;
  } else if (doctors === 2) {
    score = 3;
  } else if (doctors === 1) {
    score = 2;
  }

  // ==============================
  // PHARMACIE
  // ==============================

  if (pharmacies > 0) {
    score += 1;
  }

  // ==============================
  // DENTISTE
  // ==============================

  if (dentists > 0) {
    score += 1;
  }

  // ==============================
  // PLAFOND SANS HÔPITAL
  // ==============================

  return Math.min(9, score);
}





function calculateRiskScore(city) {
  const recent =
    city.risks?.floodCatNat10Years;

  const historical =
    city.risks?.floodCatNat;

  if (recent == null || historical == null) {
    return 5;
  }

  // RISQUE RÉCENT : priorité
  if (recent >= 9) return 0;
  if (recent >= 7) return 1;
  if (recent >= 5) return 3;
  if (recent >= 3) return 5;
  if (recent === 2) return 6;
  if (recent === 1) return 8;

  // Aucune reconnaissance récente :
  // on regarde l'historique depuis 1982
  if (historical === 0) return 10;
  if (historical <= 2) return 9;
  if (historical <= 4) return 8;
  if (historical <= 6) return 7;
  if (historical <= 8) return 6;
  if (historical <= 10) return 5;

  return 4;
}







const criteria = [
  "price",
  "commerce",
  "health",
  "safety",
  "population",
     "activities",
  "risk"
];

function calculateScore(city, preferences) {
  const budget = Number(document.getElementById("budget").value);
  const surface = Number(document.getElementById("surface").value);
  const maxPrice = surface > 0 ? budget / surface : 0;

  // ==============================
  // SCORE DU BUDGET
  // ==============================

  const realHousePrice = city.immobilier?.housePriceM2;

  let budgetScore = 5;

  if (realHousePrice != null && maxPrice > 0) {
    if (realHousePrice <= maxPrice) {
      budgetScore = 10;
    } else {
      const difference =
        (realHousePrice - maxPrice) / maxPrice;

      if (difference <= 0.05) {
        budgetScore = 9;
      } else if (difference <= 0.10) {
        budgetScore = 8;
      } else if (difference <= 0.15) {
        budgetScore = 7;
      } else if (difference <= 0.20) {
        budgetScore = 6;
      } else if (difference <= 0.30) {
        budgetScore = 4;
      } else if (difference <= 0.40) {
        budgetScore = 2;
      } else {
        budgetScore = 0;
      }
    }
  }

  // ==============================
  // SCORE GLOBAL
  // ==============================

  let totalWeight = 0;
  let weightedScore = 0;

  criteria.forEach((criterion) => {
    let score = null;
    let useCriterion = true;

    if (criterion === "price") {
      score = budgetScore;

    } else if (criterion === "commerce") {
      score = calculateCommerceScore(city);

    } else if (criterion === "health") {
      score = calculateHealthScore(city);

    } else if (criterion === "activities") {
      score = calculateActivitiesScore(city);

    } else if (criterion === "population") {
      const population = city.population;

      if (population == null) {
        useCriterion = false;
      } else if (population <= 500) {
        score = 10;
      } else if (population <= 1000) {
        score = 9;
      } else if (population <= 2000) {
        score = 8;
      } else if (population <= 5000) {
        score = 6;
      } else if (population <= 10000) {
        score = 4;
      } else if (population <= 20000) {
        score = 2;
      } else {
        score = 0;
      }

    } else if (criterion === "risk") {
      score = calculateRiskScore(city);

    } else if (criterion === "safety") {
      if (city.security?.score != null) {
        score = city.security.score;
      } else {
        useCriterion = false;
      }

    } else {
      score = city.scores?.[criterion] ?? 5;
    }

    const weight = preferences[criterion] ?? 0;



    if (
      useCriterion &&
      score != null &&
      weight > 0
    ) {
      totalWeight += weight;
      weightedScore += score * weight;
    }
  });

  // ==============================
  // SCORE FINAL
  // ==============================

  if (totalWeight === 0) {
    return 0;
  }

  return Math.round(
    (weightedScore / totalWeight) * 10
  );
}

