        ? cityPrice
        : null;

  const immoSales = Number(immobilierData?.houseSales);
  const citySales = Number(city.immobilier?.houseSales);

  const finalHouseSales =
    Number.isFinite(immoSales) && immoSales > 0
      ? immoSales
      : Number.isFinite(citySales) && citySales > 0
        ? citySales
        : 0;
let parisPrice = finalHousePriceM2;

if (code === "75056") {
  parisPrice = 10088;
}
  return {

    id: city.id,
    code: code,
    slug: city.slug,

