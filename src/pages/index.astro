 async function displayResults() {
  const preferences = getPreferences();

  const selectedDepartment =
    document.getElementById("department-select").value;

  const selectedRegion =
    document.getElementById("region-select").value;

  let filteredCities = [...citiesData];

  // ==============================
  // DÉPARTEMENT
  // ==============================

  if (searchArea.value === "department" && selectedDepartment) {
    filteredCities = await loadDepartmentCities(selectedDepartment);
  


}
console.log(
  "DÉPARTEMENT CHARGÉ :",
  selectedDepartment,
  "COMMUNES :",
  filteredCities.length,
  "EXEMPLES :",
  filteredCities.slice(0, 5).map(c => c.name)
);



  // ==============================
  // RÉGION
  // ==============================

  if (searchArea.value === "region" && selectedRegion) {
    filteredCities = filteredCities.filter(
      (city) => city.regionCode === selectedRegion
    );
  }


    // ==============================
  // CRITÈRES INDISPENSABLES
  // ==============================

  const mandatoryPrice =
    document.getElementById("mandatory-price")?.checked ?? false;

  const mandatorySafety =
    document.getElementById("mandatory-safety")?.checked ?? false;

  const mandatoryHealth =
    document.getElementById("mandatory-health")?.checked ?? false;

  const mandatoryCommerce =
    document.getElementById("mandatory-commerce")?.checked ?? false;

  const mandatoryRisk =
    document.getElementById("mandatory-risk")?.checked ?? false;

  const mandatoryPriceValue =
    Number(
      document.getElementById("mandatory-price-value")?.value
    );

  const mandatorySafetyValue =
    Number(
      document.getElementById("mandatory-safety-value")?.value
    );

  const mandatoryHealthValue =
    Number(
      document.getElementById("mandatory-health-value")?.value
    );

  const mandatoryCommerceValue =
    Number(
      document.getElementById("mandatory-commerce-value")?.value
    );

  const mandatoryRiskValue =
    Number(
      document.getElementById("mandatory-risk-value")?.value
    );

  filteredCities = filteredCities.filter((city) => {

    if (mandatoryPrice) {
      const price = city.immobilier?.housePriceM2;

      if (
        price == null ||
        price > mandatoryPriceValue
      ) {
        return false;
      }
    }

    if (mandatorySafety) {
  const score =
    city.security?.score ?? null;

      if (
       
        score == null ||
        score < mandatorySafetyValue
      ) {
        return false;
      }
    }

    if (mandatoryHealth) {
      const score =
        calculateHealthScore(city);

      if (
        score == null ||
        score < mandatoryHealthValue
      ) {
        return false;
      }
    }

    if (mandatoryCommerce) {
      const score =
        calculateCommerceScore(city);

      if (
        score == null ||
        score < mandatoryCommerceValue
      ) {
        return false;
      }
    }

    if (mandatoryRisk) {
      const score =
        calculateRiskScore(city);

      if (
        score == null ||
        score < mandatoryRiskValue
      ) {
        return false;
      }
    }

    return true;
  });

  // ==============================
// CLASSEMENT
// ==============================




const rankedCities = filteredCities
  .map((city) => {

    const finalScore =
      calculateScore(city, preferences);

    let totalPossibleWeight = 0;
    let availableWeight = 0;

    criteria.forEach((criterion) => {

if (city.name === "Marquixanes") {
  console.log("SERVICES MARQUIXANES :", city.services);
}

      const weight =
        preferences[criterion] ?? 0;

      if (weight <= 0) return;

      totalPossibleWeight += weight;

      let available = false;




      if (criterion === "price") {
        available =
          city.immobilier?.housePriceM2 != null;

      } else if (criterion === "commerce") {
        available =
          calculateCommerceScore(city) != null;

      } else if (criterion === "health") {
        available =
          calculateHealthScore(city) != null;

      } else if (criterion === "activities") {
        available =
          calculateActivitiesScore(city) != null;

      } else if (criterion === "population") {
        available =
          city.population != null;

      } else if (criterion === "risk") {
        available =
          calculateRiskScore(city) != null;

      } else if (criterion === "safety") {
        available =
          city.security?.score != null;
      }

console.log(
  "  → disponible =",
  available
);
console.log(
  "FIABILITÉ :",
  city.name,
  "|",
  criterion,
  "| poids:",
  weight,
  "| disponible:",
  available
);
      if (available) {
        availableWeight += weight;
      }
    });

    const reliability =
      totalPossibleWeight > 0
        ? Math.round(
            (availableWeight /
              totalPossibleWeight) * 100
          )
        : 0;

    const rankingScore =
      finalScore *
      (0.5 + 0.5 * reliability / 100);

console.log(
  "CLASSEMENT :",
  city.name,
  "score =", finalScore,
  "fiabilité =", reliability,
  "classement =", rankingScore
);

    return {
      ...city,
      finalScore,
      reliability,
      rankingScore
    };

  })
  .sort(
    (a, b) =>
      b.rankingScore - a.rankingScore
  );




const resultCount =
  document.getElementById("result-count");

if (resultCount) {
  resultCount.textContent =
    `${rankedCities.length} commune${
      rankedCities.length > 1 ? "s" : ""
    } correspondent à vos critères`;
}

  const container = document.getElementById("results-list");

  if (rankedCities.length === 0) {
    container.innerHTML = `
      <div class="empty">
        <h3>Aucune ville ne correspond</h3>
        <p>
          Nous n'avons pas encore de communes dans cette zone
          dans notre base de données.
        </p>
      </div>
    `;


    return;
  }

  // ==============================
  // AFFICHAGE DES VILLES
  // ==============================

  container.innerHTML = rankedCities.map((city, index) => {

    const price = city.immobilier?.housePriceM2;
    const sales = city.immobilier?.houseSales;

    const safetyScore =
  city.security?.score != null
  ? city.security.score
    : null;

    const cityCode = city.id || city.code;

    return `
      <article
        class="city-card"
        data-city-code="${cityCode}"
        tabindex="0"
      >

        <div>
          <h3>
            <span class="rank">${index + 1}.</span>
            ${city.name}
          </h3>

          <p>${city.region || ""}</p>

          <p>
            ${(city.population || 0).toLocaleString("fr-FR")}
            habitants
          </p>

          <p>
            🏠 Prix maison :
            ${
              price != null
                ? price.toLocaleString("fr-FR") + " €/m²"
                : "Non disponible"
            }
            ${
              sales
                ? ` · ${sales} ventes`
                : ""
            }
          </p>

          <p>
            ☀️
            ${
              city.sunHours
                ? city.sunHours.toLocaleString("fr-FR") + " h/an"
                : "Ensoleillement à venir"
            }
          </p>

          <p>
            🛡️ Sécurité :
            ${
              safetyScore != null
                ? safetyScore.toLocaleString("fr-FR") + "/10"
                : "Données insuffisantes"
            }
          </p>
        </div>

        <div class="score">
  ${city.finalScore}/100
</div>

<a
  href="/villes/${encodeURIComponent(String(city.code))}/"
  class="fiche-link"
  onclick="event.stopPropagation()"
>
  📋 Voir la fiche complète →
</a>

</article>
    `;
  }).join("");

  // ==============================
  // CLIC SUR UNE VILLE
  // ==============================

  container
    .querySelectorAll(".city-card")
  .forEach((card) => {
    card.addEventListener("click", () => {
      const code = card.dataset.cityCode;

      const city = rankedCities.find(
        (item) =>
          String(item.id || item.code) === String(code)
      );

      if (city) {
        showCityDetails(city);
      }
    });
  });
} 

departmentSelect.addEventListener("change", async () => {
  await displayResults();
});


regionSelect.addEventListener("change", () => {
  displayResults();
});

   
    // =====================================
// CRITÈRES INDISPENSABLES
// =====================================

const mandatoryCriteria = [
  "price",
  "safety",
  "health",
  "commerce",
  "risk"
];

mandatoryCriteria.forEach((criterion) => {
  const checkbox =
    document.getElementById(`mandatory-${criterion}`);

  const mandatorySlider =
    document.getElementById(
      `mandatory-${criterion}-value`
    );

  const mandatoryDisplay =
    document.getElementById(
      `mandatory-${criterion}-display`
    );

  // Curseur de priorité correspondant
  const prioritySlider =
    document.getElementById(criterion);

  if (
    !checkbox ||
    !mandatorySlider ||
    !mandatoryDisplay
  ) {
    return;
  }

  checkbox.addEventListener("change", () => {

    // Active/désactive le seuil obligatoire
    mandatorySlider.disabled =
      !checkbox.checked;

    // Si le critère devient obligatoire,
    // il ne peut plus être une priorité.
    if (prioritySlider) {
      prioritySlider.disabled =
        checkbox.checked;
    }
  });

  mandatorySlider.addEventListener("input", () => {




    if (criterion === "price") {
      mandatoryDisplay.textContent =
        Number(mandatorySlider.value)
          .toLocaleString("fr-FR") +
        " €/m²";
    } else {
      mandatoryDisplay.textContent =
        `${mandatorySlider.value}/10`;
    }
  });
});



