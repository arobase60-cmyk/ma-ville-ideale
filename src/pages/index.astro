function calculateActivitiesScore(city) {
  const activities = city.services?.activities;

  if (!activities) return null;

  // ==============================
  // SPORT / 5
  // ==============================

  let sportScore = 0;

  if ((activities.swimmingPool ?? 0) > 0) sportScore += 1;
  if ((activities.stadium ?? 0) > 0) sportScore += 1;
  if ((activities.tennis ?? 0) > 0) sportScore += 1;
  if ((activities.gymnasium ?? 0) > 0) sportScore += 1;
  if ((activities.golf ?? 0) > 0) sportScore += 1;

  // ==============================
  // CULTURE / 5
  // ==============================

  let cultureScore = 0;

  if ((activities.theatre ?? 0) > 0) cultureScore += 1;
  if ((activities.cinema ?? 0) > 0) cultureScore += 1;
  if ((activities.cultural ?? 0) > 0) cultureScore += 1;
  if ((activities.library ?? 0) > 0) cultureScore += 1;
  if ((activities.conservatory ?? 0) > 0) cultureScore += 1;

  return sportScore + cultureScore;
}

